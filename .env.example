# Template listing every environment variable the app uses.
# This file is committed: never put real values or secrets here.
#
# Setup: copy it to .env.local (git-ignored) and fill in the values:
#   cp .env.example .env.local

# Path to the SQLite database file, e.g. ./data/tasks.db
# Optional: leave empty to use the default (./data/tasks.db).
DATABASE_PATH=
