{
  "name": "personal-task-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Personal task management app built with Next.js and SQLite",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tests",
    "seed": "node scripts/seed.mjs",
    "test": "npm run test:unit && npm run test:component",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:component": "cypress run --component",
    "test:component:open": "cypress open --component"
  },
  "dependencies": {
    "@next/env": "^16.3.8",
    "better-sqlite3": "^13.0.3",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
